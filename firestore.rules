rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared public access for this cooperative/shop environment to enable sync
    match /products/{productId} {
      allow read, write: if true;
    }
    match /sales/{saleId} {
      allow read, write: if true;
    }
    match /preorders/{preorderId} {
      allow read, write: if true;
    }
    match /activeOrders/{activeOrderId} {
      allow read, write: if true;
    }
    match /shopInfo/{infoId} {
      allow read, write: if true;
    }
    match /customers/{customerId} {
      allow read, write: if true;
    }
  }
}
