{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Product in inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "cost": { "type": "number" },
        "stock": { "type": "number" },
        "reserved": { "type": "number" },
        "category": { "type": "string" },
        "sku": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "name", "price", "cost", "stock", "reserved", "category", "sku"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed POS Sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "orderDate": { "type": "string" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "amountPaid": { "type": "number" },
        "change": { "type": "number" },
        "customerName": { "type": "string" },
        "serviceType": { "type": "string" },
        "tableNumber": { "type": "string" },
        "orderNumber": { "type": "string" }
      },
      "required": ["id", "date", "total", "paymentMethod", "amountPaid", "change"]
    },
    "Preorder": {
      "title": "Preorder",
      "description": "Preorder status and items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "deliveryMode": { "type": "string" },
        "shippingCost": { "type": "number" },
        "milestone": { "type": "string" },
        "total": { "type": "number" }
      },
      "required": ["id", "date", "customerName", "deliveryMode", "shippingCost", "milestone", "total"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Registered shop customers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "ActiveOrder": {
      "title": "ActiveOrder",
      "description": "Kitchen Order Monitor status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "amountPaid": { "type": "number" },
        "change": { "type": "number" },
        "customerName": { "type": "string" },
        "serviceType": { "type": "string" },
        "tableNumber": { "type": "string" },
        "orderNumber": { "type": "string" }
      },
      "required": ["id", "status", "total"]
    },
    "ShopInfo": {
      "title": "ShopInfo",
      "description": "Shop Metadata and Settings",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "qrisImage": { "type": "string" },
        "systemPin": { "type": "string" }
      },
      "required": ["name", "address", "phone", "message"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "List of products in inventory"
    },
    "sales/{saleId}": {
      "schema": "Sale",
      "description": "POS sales history"
    },
    "preorders/{preorderId}": {
      "schema": "Preorder",
      "description": "List of preorder orders"
    },
    "activeOrders/{activeOrderId}": {
      "schema": "ActiveOrder",
      "description": "Active kitchen and counter orders"
    },
    "shopInfo/{infoId}": {
      "schema": "ShopInfo",
      "description": "General shop configurations"
    },
    "customers/{customerId}": {
      "schema": "Customer",
      "description": "Registered customer profiles"
    }
  }
}
